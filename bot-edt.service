# Service systemd pour le bot Discord emploi du temps.
# 1. Adapte les chemins et l'utilisateur ci-dessous.
# 2. sudo cp bot-edt.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now bot-edt
# 4. journalctl -u bot-edt -f   (pour voir les logs)

[Unit]
Description=Bot Discord - Emploi du temps M1_RES_ALT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME_utilisateur
WorkingDirectory=/chemin/vers/bot-discord-edt
EnvironmentFile=/chemin/vers/bot-discord-edt/.env
ExecStart=/chemin/vers/bot-discord-edt/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
