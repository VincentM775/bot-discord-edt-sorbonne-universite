# === Discord ===
# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=colle_ton_token_ici
# ID du salon où poster l'emploi du temps (clic droit sur le salon > Copier l'identifiant)
DISCORD_CHANNEL_ID=123456789012345678

# === Calendrier CalDAV (UFR Info P6 - Jussieu) ===
# URL de la collection à suivre. Par défaut : M1_RES Alternance (M1_RES_ALT).
CALDAV_URL=https://cal.ufr-info-p6.jussieu.fr:443/caldav.php/RES/M1_RES-ITESCIA/
# Identifiants publics du calendrier "invité" (extraits du config.js du site)
CALDAV_USER=student.master
CALDAV_PASSWORD=guest

# === Planification ===
# Heure d'envoi (fuseau Europe/Paris), format HH:MM sur 24h. Ex: 18:00 = 18h le soir.
SEND_TIME=18:00
# Quel jour envoyer : "tomorrow" (les cours du lendemain, le soir) ou "today".
SEND_FOR=tomorrow
# Poster un message même s'il n'y a aucun cours ? true / false
POST_WHEN_EMPTY=true

# === Récapitulatif hebdomadaire ===
# Poster un aperçu de la semaine à venir, la veille au soir ? true / false
WEEKLY_ENABLED=true
# Heure d'envoi de l'aperçu hebdo (Europe/Paris), HH:MM
WEEKLY_TIME=18:00
# Jour d'envoi : 0 = lundi ... 6 = dimanche. Défaut 6 = dimanche soir (la veille).
WEEKLY_DAY=6
# Nombre de jours affichés : 5 = lundi->vendredi, 7 = semaine complète
WEEKLY_DAYS=5
